{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/voice-bridge/Dockerfile",
    "watchPatterns": [
      "/apps/voice-bridge/**",
      "/apps/api/claim_api/gradium_bridge.py",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 120
  }
}
