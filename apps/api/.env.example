APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Auth verification for GET /v1/me. Use the legacy JWT secret OR a
# JWKS URL for projects using asymmetric signing keys. Both values are server-only.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# Server-only Storage administration key; never use this in apps/web.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=claim-evidence

# Server-only PostgreSQL connection string (Supabase transaction pooler).
DATABASE_URL=
DATABASE_ALLOW_INSECURE_LOCAL=false

# Optional direct/session-capable connection reserved for Alembic migrations.
MIGRATION_DATABASE_URL=

# Optional API-only local testing. Never set these on Vercel or in production.
LOCAL_DEV_AUTH=false
LOCAL_DEV_BEARER_TOKEN=

# Joint photo/video analysis (server-only). Default provider is Gemini.
# gemini for every case; hybrid uses Pipelex/OpenAI for text-only cases and
# Gemini for cases with an attached photo, video, or PDF.
ANALYSIS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Dust specialists receive text/structured Gemini findings, never video files.
# Use https://eu.dust.tt only for a workspace hosted in the EU region.
DUST_API_KEY=
DUST_API_BASE_URL=https://dust.tt
DUST_WORKSPACE_ID=0G0kj9rhj8
DUST_AGENT_LEGAL=sduIybtm6M
DUST_AGENT_CCTV=qBEkK3Nkg3
DUST_AGENT_REPAIR=HwU56jOUcl
DUST_AGENT_GARAGE=39cz24sZfG
DUST_AGENT_RECOVERY=QC7kvgzlNa

# Legacy metadata-only analysis: set ANALYSIS_PROVIDER=pipelex.
# Keep it in the API environment only; never add it to the web bundle.
OPENAI_API_KEY=

# Optional server tracing; absent by default. When set, traces go to Logfire EU.
# Request attributes/bodies are scrubbed by the API instrumentation.
LOGFIRE_TOKEN=

# Use fake_whatsapp for the private browser phone demo. No external WhatsApp send occurs.
WHATSAPP_DELIVERY_MODE=mock

# One-way French SMS invitation. Keep disabled until the Twilio service, callback,
# production migration and opt-in test are ready. Text replies and photos use /depot.
SMS_LINK_DELIVERY_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_MESSAGING_SERVICE_SID=MG77be4e6c8d35a9423917e9ad99ff2c9c
TWILIO_SMS_WEBHOOK_BASE_URL=https://claimroom-demo-api.vercel.app/v1/webhooks/twilio/sms
# Automatic media workflow and real, explicitly reviewed email delivery.
MEDIA_WORKER_TOKEN=
RESEND_API_KEY=
CLAIMROOM_EMAIL_FROM=
CLAIMROOM_EMAIL_REPLY_TO=

# Automatic claims journey: Astra compares insured photos to the local synthetic video catalogue.
# The existing MEDIA_WORKER_* configuration runs this pipeline even with the browser closed.
# OPENAI_API_KEY is server-side only. The requested model is gpt-6-astra (no silent fallback).
CLAIM_NOTIFICATION_MODE=simulated
# In live mode the fictional insurer's email is redirected to this explicitly selected test inbox.
CLAIM_EMAIL_TO=
# Legacy alias; CLAIM_EMAIL_TO takes precedence when both are configured.
CLAIM_DEMO_INSURER_EMAIL=

# Garage suggestions after photos arrive. SMS simulation is the default.
# A separate worker must run: python -m claim_api.garage_worker
GARAGE_SMS_MODE=mock
# Primary trigger: the accident photos are saved by the deposit flow.
# Set mms only if migrating to a compatible Twilio inbound number later.
GARAGE_SMS_TRIGGER=photos
# Reuses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN from the SMS pilot above.
TWILIO_PHONE_NUMBER=
# Optional override; defaults to the existing TWILIO_SMS_MESSAGING_SERVICE_SID.
TWILIO_MESSAGING_SERVICE_SID=
# Optional public HTTPS origin, without path; otherwise reuses the pilot webhook origin.
TWILIO_PUBLIC_BASE_URL=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Identify the deployed app and supply a real operator contact before deployment.
OSM_USER_AGENT=ClaimroomGarageLookup/1.0
